# ====================================
# 数据库
# ====================================
# Neon Postgres 连接串
# 注册 https://neon.tech 创建项目后，从 Dashboard 复制
# 示例: postgresql://user:password@ep-xxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ====================================
# 认证 (Auth.js / NextAuth v5)
# ====================================
# 站点完整 URL，开发环境填 http://localhost:3000
AUTH_URL=http://localhost:3000

# 用于签名 session cookie 的随机密钥
# 生成命令: openssl rand -base64 32
AUTH_SECRET=

# ====================================
# Linux DO OAuth
# ====================================
# 在 https://connect.linux.do/ 创建应用获取
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# ====================================
# 管理员
# ====================================
# 初始管理员的 Linux DO 用户 ID，逗号分隔
# 这些用户首次登录会自动设为 is_admin=true
ADMIN_LINUXDO_IDS=
